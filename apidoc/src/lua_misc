function piditer(bplid pid) ->
Iterates on every pid in the broadcast pid <var>pid</var>, ordered from 0 to MAX_PLAYERS&minus;1 inclusive.
Regular pid's are a subset of broadcast pid's.

number get_time(void) ->
Returns the monotonic time in seconds elapsed since an unspecified epoch.

bplid PID_BROADCAST_TEAM(teamid team) ->
Returns a broadcast pid referring to all connected players on the given team.

bplid PID_BROADCAST_EXCEPT(plid pid) ->
Returns a broadcast pid referring to all connected players except for <var>pid</var>.

bplid PID_BROADCAST_EXCEPT_TEAM(teamid team) ->
Returns a broadcast pid referring to all connected players except for ones currently on <var>team</var>; see get_team().

bplid PID_BROADCAST_EXCEPT_TEAM_AND_PLAYER(teamid team, plid pid) ->
Returns a broadcast pid referring to all connected players except for ones currently on <var>team</var> (see get_team()) and except for <var>pid</var>.

